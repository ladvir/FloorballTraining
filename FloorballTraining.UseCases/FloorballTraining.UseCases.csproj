<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;Production database</Configurations>
    <!-- CS8601: Mapperly (like AutoMapper before) assigns a null navigation to a non-nullable DTO property
         in the generated AppMapper.g.cs; severity of generated nullable warnings cannot be set via .editorconfig. -->
    <NoWarn>$(NoWarn);CS8601</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FloorballTraining.CoreBusiness\FloorballTraining.CoreBusiness.csproj" />
    <ProjectReference Include="..\FloorballTraining.Reporting\FloorballTraining.Reporting.csproj" />
    <ProjectReference Include="..\FloorballTraining.Services.EmailService\FloorballTraining.Services.EmailService.csproj" />
    <ProjectReference Include="..\FloorballTraining.Services\FloorballTraining.Services.csproj" />
  </ItemGroup>

</Project>
